{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/etc/agntos/logo.txt",
    "color": {
      "1": "38;2;245;124;72"
    },
    "padding": {
      "top": 1,
      "right": 2,
      "left": 2
    }
  },
  "display": {
    "separator": ": "
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "separator",
    "packages",
    "shell",
    "de",
    "terminal",
    "separator",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "separator",
    "colors",
    "break"
  ]
}
